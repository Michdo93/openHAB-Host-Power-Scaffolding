{% set P = settings.item_prefix %}
// Generated by openHAB-Host-Power-Scaffolding ({{ generated }}) – regenerate instead of editing.
//
// <Host>_Power: state from the ping Thing (postUpdate), commands handled by the rule:
//   command ON  -> Wake-on-LAN, command OFF -> shutdown via SSH.
//   autoupdate="false": the item only changes when the ping confirms the new state.
// <Host>_Reboot: linked to the Exec Thing's run channel – ON runs the reboot,
//   the binding switches it back to OFF when the command has finished.
//
// The Power switches are intentionally NOT members of a common Switch group:
// a command to such a group would be forwarded to every member (= all hosts off).

Group {{ P }}gHosts "Host-Steuerung" <network>
{% for h in active %}

// ---- {{ h.label }} ({{ h.address }})
Group    {{ h.item }}  {{ h.label|q }}  <computer>  ({{ P }}gHosts)  ["Computer"]
Switch   {{ h.power_item }}  "Eingeschaltet [%s]"  <switch>  ({{ h.item }})  ["Switch", "Power"]  { channel="{{ h.ping_uid }}:online", autoupdate="false" }
DateTime {{ h.item }}_LastSeen  "Zuletzt online [%1$td.%1$tm. %1$tH:%1$tM]"  <time>  ({{ h.item }})  ["Status", "Timestamp"]  { channel="{{ h.ping_uid }}:lastseen" }
{% if h.can_reboot %}
Switch   {{ h.item }}_Reboot  "Neustart"  <switch>  ({{ h.item }})  ["Control"]  { channel="{{ h.exec_uid }}:run", autoupdate="false" }
Number   {{ h.item }}_RebootExit  "Neustart Exit-Code [%d]"  <text>  ({{ h.item }})  ["Status"]  { channel="{{ h.exec_uid }}:exit" }
String   {{ h.item }}_RebootOutput  "Neustart Ausgabe [%s]"  <text>  ({{ h.item }})  ["Status"]  { channel="{{ h.exec_uid }}:output" }
{% endif %}
{% endfor %}
