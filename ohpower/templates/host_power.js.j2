// Generated by openHAB-Host-Power-Scaffolding ({{ generated }}) – regenerate instead of editing.
// JavaScript Scripting (GraalJS, openhab-js). Copy to $OPENHAB_CONF/automation/js/.
//
// Power switch: command ON -> Wake-on-LAN, command OFF -> shutdown via SSH.
// The ping Thing only updates the item (postUpdate), which never triggers this rule,
// so switching a host on or off by hand just changes the item state.
{% set hosts = active %}
{% if not hosts %}
// No enabled hosts – nothing to do.
{% else %}

const TIMEOUT = time.Duration.ofSeconds({{ settings.command_timeout }});

// Power item -> label, ping Thing (Wake-on-LAN action), SSH command for shutdown
const HOSTS = {
{% for h in hosts %}
  {{ h.power_item|q }}: {
    label: {{ h.label|q }},
    wolThing: {% if h.can_wake %}{{ h.ping_uid|q }}{% else %}null{% endif %},
    shutdown: {% if h.can_shutdown %}[{{ h.shutdown_argv|qlist }}]{% else %}null{% endif %}

  }{{ "," if not loop.last }}
{% endfor %}
};

function wake (host) {
  if (!host.wolThing) {
    console.warn(`${host.label}: keine MAC-Adresse – Wake-on-LAN nicht möglich`);
    return;
  }
  const wol = actions.thingActions('network', host.wolThing);
  if (!wol) {
    console.warn(`${host.label}: Thing ${host.wolThing} nicht gefunden`);
    return;
  }
  wol.sendWakeOnLanPacketViaMac();
  console.info(`${host.label}: Wake-on-LAN gesendet`);
}

function shutdown (host) {
  if (!host.shutdown) {
    console.warn(`${host.label}: kein SSH-Konto/Befehl – Herunterfahren nicht möglich`);
    return;
  }
  console.info(`${host.label}: fahre per SSH herunter`);
  const out = actions.Exec.executeCommandLine(TIMEOUT, ...host.shutdown);
  if (out) {
    console.info(`${host.label}: ${out}`);
  }
}

rules.JSRule({
  name: 'Host-Power: Wake-on-LAN / SSH-Shutdown',
  description: 'Generated by openHAB-Host-Power-Scaffolding',
  id: {{ settings.rule_uid|q }},
  tags: ['HostPower'],
  triggers: Object.keys(HOSTS).map((item) => triggers.ItemCommandTrigger(item)),
  execute: (event) => {
    const host = HOSTS[event.itemName];
    if (!host) {
      return;
    }
    if (event.receivedCommand === 'ON') {
      wake(host);
    } else if (event.receivedCommand === 'OFF') {
      shutdown(host);
    }
  }
});
{% endif %}
