// Generated by openHAB-Host-Power-Scaffolding ({{ generated }}) – regenerate instead of editing.
// Rules DSL. Copy to $OPENHAB_CONF/rules/.
//
// Power switch: command ON -> Wake-on-LAN, command OFF -> shutdown via SSH.
// The ping Thing only updates the item (postUpdate), which never triggers this rule,
// so switching a host on or off by hand just changes the item state.
{% set hosts = active %}
{% if not hosts %}
// No enabled hosts – nothing to do.
{% else %}

// Power item -> [label, ping Thing (Wake-on-LAN), SSH key, SSH port, user@address, remote command]
// Empty strings mark a missing feature (no MAC / no SSH account).
val HOST_POWER = newHashMap(
{% for h in hosts %}
    {{ h.power_item|q }} -> newArrayList({{ h.label|q }}, {{ (h.ping_uid if h.can_wake else "")|q }}, {{ settings.ssh_key|q }}, {{ h.port|string|q }}, {{ (h.ssh_target if h.can_shutdown else "")|q }}, {{ (h.poweroff if h.can_shutdown else "")|q }}){{ "," if not loop.last }}
{% endfor %}
)

rule "Host-Power: Wake-on-LAN / SSH-Shutdown"
when
{% for h in hosts %}
    Item {{ h.power_item }} received command{{ " or" if not loop.last }}
{% endfor %}
then
    val h = HOST_POWER.get(triggeringItemName)
    if (h === null) return;

    if (receivedCommand == ON) {
        if (h.get(1) == "") {
            logWarn("host_power", h.get(0) + ": keine MAC-Adresse – Wake-on-LAN nicht möglich")
            return;
        }
        val wol = getActions("network", h.get(1))
        if (wol === null) {
            logWarn("host_power", h.get(0) + ": Thing " + h.get(1) + " nicht gefunden")
            return;
        }
        wol.sendWakeOnLanPacketViaMac()
        logInfo("host_power", h.get(0) + ": Wake-on-LAN gesendet")
    } else if (receivedCommand == OFF) {
        if (h.get(5) == "") {
            logWarn("host_power", h.get(0) + ": kein SSH-Konto/Befehl – Herunterfahren nicht möglich")
            return;
        }
        logInfo("host_power", h.get(0) + ": fahre per SSH herunter")
        val out = executeCommandLine(Duration.ofSeconds({{ settings.command_timeout }}), "ssh", {{ ssh_options|qlist }}, "-i", h.get(2), "-p", h.get(3), h.get(4), h.get(5))
        if (out !== null && out != "") {
            logInfo("host_power", h.get(0) + ": " + out)
        }
    }
end
{% endif %}
