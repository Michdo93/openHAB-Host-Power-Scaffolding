#
# Power switch: command ON -> Wake-on-LAN, command OFF -> shutdown via SSH.
# The ping Thing only updates the item (postUpdate), which never triggers this rule,
# so switching a host on or off by hand just changes the item state.
{% set hosts = active %}
{% if not hosts %}
# No enabled hosts - nothing to do.
{% else %}

from datetime import timedelta

from openhab import rule
from openhab.actions import Exec
from openhab.triggers import ItemCommandTrigger
from scope import actions

TIMEOUT = timedelta(seconds={{ settings.command_timeout }})

# Power item -> label, ping Thing (Wake-on-LAN action), SSH command for shutdown
HOSTS = {
{% for h in hosts %}
    {{ h.power_item|q }}: {
        "label": {{ h.label|q }},
        "wol_thing": {% if h.can_wake %}{{ h.ping_uid|q }}{% else %}None{% endif %},
        "shutdown": {% if h.can_shutdown %}[{{ h.shutdown_argv|qlist }}]{% else %}None{% endif %},
    },
{% endfor %}
}


@rule(
    name="Host-Power: Wake-on-LAN / SSH-Shutdown",
    description="Generated by openHAB-Host-Power-Scaffolding",
    tags=["HostPower"],
    uid={{ settings.rule_uid|q }},
    triggers=[ItemCommandTrigger(item) for item in HOSTS],
)
class HostPower:
    def execute(self, module, input):
        event = input["event"]
        host = HOSTS.get(event.getItemName())
        if host is None:
            return
        command = str(event.getItemCommand())
        if command == "ON":
            self.wake(host)
        elif command == "OFF":
            self.shutdown(host)

    def wake(self, host):
        if host["wol_thing"] is None:
            self.logger.warn("{}: keine MAC-Adresse - Wake-on-LAN nicht möglich".format(host["label"]))
            return
        wol = actions.get("network", host["wol_thing"])
        if wol is None:
            self.logger.warn("{}: Thing {} nicht gefunden".format(host["label"], host["wol_thing"]))
            return
        wol.sendWakeOnLanPacketViaMac()
        self.logger.info("{}: Wake-on-LAN gesendet".format(host["label"]))

    def shutdown(self, host):
        if host["shutdown"] is None:
            self.logger.warn("{}: kein SSH-Konto/Befehl - Herunterfahren nicht möglich".format(host["label"]))
            return
        self.logger.info("{}: fahre per SSH herunter".format(host["label"]))
        out = Exec.executeCommandLine(TIMEOUT, *host["shutdown"])
        if out:
            self.logger.info("{}: {}".format(host["label"], out))
{% endif %}
