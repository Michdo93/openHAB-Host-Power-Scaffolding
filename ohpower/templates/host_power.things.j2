// Network Binding: ping Thing per host (online state + Wake-on-LAN via macAddress)
// Exec Binding:    one reboot Thing per host (every command must be in misc/exec.whitelist)
{% for h in active %}

// {{ h.label }} – {{ h.address }} ({{ h.os }}){% if not h.can_wake %} – keine MAC, kein Wake-on-LAN{% endif %}

{% if h.ping_own %}
Thing {{ h.ping_uid }} {{ (h.label ~ " – Ping")|q }} @ {{ h.location|q }} [ hostname={{ h.address|q }}{% if h.mac %}, macAddress={{ h.mac|q }}{% endif %}, refreshInterval={{ settings.ping_refresh }} ]
{% else %}
// Ping-Thing wird extern definiert: {{ h.ping_uid }}{% if h.mac %} (braucht macAddress="{{ h.mac }}"){% endif %}

{% endif %}
{% if h.can_reboot %}
Thing {{ h.exec_uid }} {{ (h.label ~ " – Neustart")|q }} @ {{ h.location|q }} [ command={{ h.reboot_command|q }}, interval=0, timeout={{ settings.command_timeout }}, autorun=false ]
{% endif %}
{% endfor %}
